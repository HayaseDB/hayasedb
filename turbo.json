{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "ui": "stream",
  "concurrency": "16",
  "globalDependencies": [
    ".nvmrc",
    "bunfig.toml",
    "vitest.config.ts",
    "vitest.presets.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!.nuxt/**", "!.output/**", "!dist/**"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "GIT_SHA"],
      "passThroughEnv": ["INTERNAL_API_TOKEN"]
    },
    "prepare": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.nuxt/**"],
      "outputs": [".nuxt/**"]
    },
    "check-types": {
      "dependsOn": ["^build", "prepare"]
    },
    "lint": {
      "dependsOn": ["prepare"]
    },
    "test": {
      "dependsOn": ["^build", "prepare"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.nuxt/**",
        "!.output/**",
        "!dist/**",
        "!coverage/**"
      ],
      "passThroughEnv": ["CI", "VITEST_POOL_ID"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL", "POSTGRES_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "NODE_ENV",
        "INTERNAL_API_TOKEN",
        "DATABASE_URL",
        "POSTGRES_*",
        "REDIS_*",
        "API_*",
        "AUTH_*",
        "WEB_*",
        "ADMIN_*",
        "STORAGE_*",
        "MAIL_*",
        "MAILPIT_*",
        "GITHUB_*",
        "DISCORD_*",
        "NUXT_*",
        "NITRO_*",
        "SHUTDOWN_DRAIN_MS"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "TESTCONTAINERS_*",
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
        "CI",
        "VITEST_POOL_ID"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "NODE_ENV",
        "DOCKER_HOST",
        "E2E_*",
        "PLAYWRIGHT_*",
        "DATABASE_URL",
        "POSTGRES_*",
        "REDIS_*",
        "STORAGE_*",
        "MAIL_*",
        "MAILPIT_*",
        "AUTH_*",
        "INTERNAL_API_TOKEN",
        "API_*",
        "WEB_*",
        "ADMIN_*",
        "NUXT_*",
        "NITRO_*"
      ]
    }
  }
}
